# ==============================================================
# SynQ — Environment Variable Template
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ==============================================================

# --------------------------------------------------------------
# IBM watsonx.ai
# Get these from your IBM Cloud / hackathon portal.
# --------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model IDs — change if the hackathon provisions different models
LLM_MODEL_ID=ibm/granite-3-3-8b-instruct
EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr
EMBEDDING_DIMENSION=384

# --------------------------------------------------------------
# Authentication
# Generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
# --------------------------------------------------------------
JWT_SECRET=change-me-in-development
JWT_EXPIRE_HOURS=8

# --------------------------------------------------------------
# Database
# Local dev: set automatically by Docker Compose (postgres service).
# Production (Neon.tech): use the connection string from the dashboard.
# Add ?sslmode=require for Neon connections.
# --------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://user:password@host/synq?sslmode=require

# --------------------------------------------------------------
# Frontend (Vercel)
# Set VITE_API_BASE_URL in the Vercel project environment variables.
# For local dev this is empty — the Vite proxy handles routing.
# --------------------------------------------------------------
# VITE_API_BASE_URL=https://your-app.us-south.codeengine.appdomain.cloud/api/v1
