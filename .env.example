# ==============================================================
# SynQ — Environment Variable Template
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ==============================================================

# --------------------------------------------------------------
# Google AI Studio (Gemini)
# Get a free API key (no credit card) at:
#   https://aistudio.google.com/apikey
# --------------------------------------------------------------
GOOGLE_API_KEY=

# Chat model. Confirm which models have a free-tier row for your key at
# https://aistudio.google.com/rate-limit and change this if needed.
LLM_MODEL_ID=gemini-2.0-flash

# Embeddings. gemini-embedding-001 supports task types and can be truncated
# to a narrower width; gemini-embedding-2-preview does NOT accept task_type.
EMBEDDING_MODEL_ID=gemini-embedding-001

# Vector width written to the chunks.embedding pgvector column.
# Changing this requires a new Alembic migration. Google recommends 3072,
# 1536 or 768 for gemini-embedding-001.
EMBEDDING_DIMENSION=768

# --------------------------------------------------------------
# Authentication
# Generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
# --------------------------------------------------------------
JWT_SECRET=change-me-in-development
JWT_EXPIRE_HOURS=8

# --------------------------------------------------------------
# Database
# Local dev: set automatically by Docker Compose (postgres service).
# Production (Neon.tech): use the connection string from the dashboard.
# Add ?sslmode=require for Neon connections.
# --------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://user:password@host/synq?sslmode=require

# --------------------------------------------------------------
# Frontend (Vercel)
# Set VITE_API_BASE_URL in the Vercel project environment variables.
# For local dev this is empty — the Vite proxy handles routing.
# --------------------------------------------------------------
# VITE_API_BASE_URL=https://your-backend.your-domain.com/api/v1
